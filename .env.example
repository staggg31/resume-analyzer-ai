# ResumeLens AI - Environment Configuration

# Required: Your Groq API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: Groq Model Selection (default: openai/gpt-oss-120b)
# Verified active Developer tier models:
# - openai/gpt-oss-120b (Recommended flagship: 131k context, high quality, JSON mode support)
# - openai/gpt-oss-20b (Ultra-fast lightweight alternative)
GROQ_MODEL=openai/gpt-oss-120b
